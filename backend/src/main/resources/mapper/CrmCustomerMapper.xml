<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.beautysalon.mapper.CrmCustomerMapper">

    <!-- 根据手机号查询 -->
    <select id="selectByPhone" resultType="com.beautysalon.entity.CrmCustomer">
        SELECT * FROM crm_customer
        WHERE phone = #{phone} AND deleted = 0
    </select>

    <!-- 根据手机号统计 -->
    <select id="countByPhone" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM crm_customer
        WHERE phone = #{phone} AND deleted = 0
    </select>

</mapper>
