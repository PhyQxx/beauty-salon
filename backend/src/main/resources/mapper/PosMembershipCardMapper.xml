<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.beautysalon.mapper.PosMembershipCardMapper">

    <!-- 根据卡编码查询 -->
    <select id="selectByCode" resultType="com.beautysalon.entity.PosMembershipCard">
        SELECT * FROM pos_membership_card
        WHERE code = #{code}
        AND deleted = 0
    </select>

</mapper>
