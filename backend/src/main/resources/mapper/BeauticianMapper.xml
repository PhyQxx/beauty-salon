<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.beautysalon.mapper.BeauticianMapper">

    <!-- 根据工号查询 -->
    <select id="selectByCode" resultType="com.beautysalon.entity.Beautician">
        SELECT * FROM beautician
        WHERE code = #{code} AND deleted = 0
    </select>

    <!-- 根据手机号查询 -->
    <select id="selectByPhone" resultType="com.beautysalon.entity.Beautician">
        SELECT * FROM beautician
        WHERE phone = #{phone} AND deleted = 0
    </select>

    <!-- 查询上岗中的美容师 -->
    <select id="selectActive" resultType="com.beautysalon.entity.Beautician">
        SELECT * FROM beautician
        WHERE deleted = 0 AND status = 1
        ORDER BY create_time DESC
    </select>

</mapper>
